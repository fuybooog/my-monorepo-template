# ============================================================
# 环境变量模板（仅此文件提交到 git，其余 .env* 均被 gitignore）
# 用法：复制为实际环境文件并填写本机配置
#   cp .env.example .env.development   # 本地开发
#   cp .env.example .env.test          # 本地 e2e 测试（DB_DATABASE 指向测试库）
#   cp .env.example .env.production    # 生产
# ============================================================

# 运行环境：development / test / production
NODE_ENV=development
PORT=3000

# JWT 密钥：示例值仅用于本地开发，生产环境务必替换为强随机值
JWT_SECRET=Mjg1NTAyOTMtYmFjYi00ZDU0LThmMDYtM2MzN2M0YmRjMzFlCg==

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
# 本地数据库密码（不提交真实密码到 git）
DB_PASSWORD=<your-db-password>
DB_DATABASE=mydb

# Redis（单点登录 token 管理）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS 允许的域名（逗号分隔）
CORS_ALLOWED_DOMAINS=dev.company.com,test.company.com

# SMTP 邮件服务（找回密码验证码发送）
# MAIL_PASS 是 SMTP 授权码（非登录密码），需在邮箱设置中开启 SMTP 后生成
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=系统管理员
