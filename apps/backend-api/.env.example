# ============================================================
# 环境变量模板（仅此文件提交到 git，其余 .env* 均被 gitignore）
# 用法：复制为实际环境文件并填写本机配置
#   cp .env.example .env.development   # 本地开发
#   cp .env.example .env.test          # 本地 e2e 测试（DB_DATABASE 指向测试库）
#   cp .env.example .env.production    # 生产
# ============================================================

# 运行环境：development / test / production
NODE_ENV=development
PORT=3000

# JWT 密钥：示例值仅用于本地开发，生产环境务必替换为强随机值
JWT_SECRET=Mjg1NTAyOTMtYmFjYi00ZDU0LThmMDYtM2MzN2M0YmRjMzFlCg==

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
# 本地数据库密码（不提交真实密码到 git）
DB_PASSWORD=<your-db-password>
DB_DATABASE=mydb

# Redis（单点登录 token 管理）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS 允许的域名（逗号分隔）
CORS_ALLOWED_DOMAINS=dev.company.com,test.company.com

# ============================================================
# 安全配置
# ============================================================

# 反向代理层数：部署在 Nginx/CDN 之后时填写对应层数（最常用 1）。
# 直接影响限流/登录锁定取到的客户端 IP：
#   配置错误 → 所有用户被识别为同一个代理 IP → IP 维度限流会把整个网段一起锁死；
#   未走反代请显式设为 0 或 false（此时客户端无法伪造 X-Forwarded-For）。
TRUST_PROXY=1

# 是否启用 CSRF 校验（双提交 Cookie）：状态变更请求需回传 X-CSRF-Token 请求头
CSRF_ENABLED=true

# 全局默认限流：窗口内允许的请求数 / 窗口长度（毫秒）
THROTTLE_LIMIT=300
THROTTLE_TTL=60000

# 登录类接口限流（密码登录、找回密码）
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000

# 凭证下发接口限流（RSA 公钥、图形验证码）：密钥生成 CPU 开销高
CREDENTIAL_THROTTLE_LIMIT=20
CREDENTIAL_THROTTLE_TTL=60000

# 账号维度登录失败锁定：连续失败 LOGIN_MAX_FAIL 次后锁定 LOGIN_LOCK_SECONDS 秒
LOGIN_MAX_FAIL=5
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# IP 维度登录失败锁定（跨账号撞库防护，阈值需显著高于账号维度）
LOGIN_IP_MAX_FAIL=30
LOGIN_IP_FAIL_WINDOW_SECONDS=600
LOGIN_IP_LOCK_SECONDS=900

# 开发环境旁路：允许跳过图形验证码、密码以明文传输（仅限本机联调）
# 生产环境必须留空或 false，否则等同于开放一条公网明文口令通道
ALLOW_DEV_LOGIN_BYPASS=false

# SMTP 邮件服务（找回密码验证码发送）
# MAIL_PASS 是 SMTP 授权码（非登录密码），需在邮箱设置中开启 SMTP 后生成
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=系统管理员
