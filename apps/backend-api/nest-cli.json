{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "./tsconfig.json"
  },
  "watchOptions": {
    "watchAssets": false,
    "exclude": ["**/*spec.ts", "**/*e2e-spec.ts"]
  }
}
