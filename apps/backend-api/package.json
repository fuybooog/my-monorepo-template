{
  "name": "@repo/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --no-warn-ignored",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json -i",
    "db:sync": "pnpm exec tsx ./scripts/db-sync.ts",
    "generate:module": "pnpm exec tsx ./scripts/generate-module.ts",
    "generate:dto": "pnpm exec tsx ./scripts/generate-base-dto.ts",
    "delete:module": "pnpm exec tsx ./scripts/delete-module.ts",
    "start:redis": "redis-server",
    "build:openapi": "ts-node -r tsconfig-paths/register -P tsconfig.build.json scripts/generate-openapi.ts",
    "dev": "cross-env NODE_ENV=development concurrently \"nest start --watch\" \"pnpm run watch:openapi\" ",
    "watch:openapi": "chokidar \"src/**/*.dto.ts\" \"src/**/*.controller.ts\" \"src/**/*.entity.ts\" -c \"pnpm run build:openapi && pnpm --filter @repo/types generate\" "
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.1",
    "@repo/shared": "workspace:*",
    "@repo/types": "workspace:*",
    "@types/node-forge": "^1.3.14",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^10.0.3",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.21",
    "ioredis": "^5.11.1",
    "mysql2": "^3.22.5",
    "node-forge": "^1.4.0",
    "qs": "^6.15.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typeorm-model-generator": "^0.4.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
