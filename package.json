{
  "name": "my-monorepo-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev:backend": "pnpm --filter @repo/backend dev",
    "dev:h5": "pnpm --filter @repo/h5 dev",
    "dev:pc": "pnpm --filter @repo/pc dev",
    "start:redis": "pnpm --filter @repo/backend start:redis",
    "db:sync": "pnpm --filter @repo/backend db:sync",
    "build:all": "pnpm --filter \"./apps/*\" build",
    "dev": "turbo run dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format": "turbo run format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "axios": "^1.17.0",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nano-staged": "^1.0.2",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.16",
    "typescript-eslint": "^8.60.1"
  }
}
