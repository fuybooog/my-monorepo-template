    "/user": {
      "get": {
        "operationId": "SystemUserController_pageOptionUser",
        "parameters": [
          {
            "name": "keyword",
            "required": true,
            "in": "query",
            "description": "关键字，可输入姓名，手机号，身份证等",
            "schema": {
              "example": "张三",
              "type": "string"
            }
          },
          {
            "name": "fields",
            "required": true,
            "in": "query",
            "description": "返回的字段，默认是id，userName",
            "schema": {
              "example": "testId",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分页成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PaginatedResult"
                            },
                            {
                              "properties": {
                                "list": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/components/schemas/SystemUserPageResp"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "分页查询用户列表(可选字段)",
        "tags": ["SystemUser"]
      },
