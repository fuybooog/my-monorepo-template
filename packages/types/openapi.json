  "info": {
    "title": "BACKED API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ResponseHeadDto": {
        "type": "object",
        "properties": {
          "errCode": {
            "type": "number",
            "description": "错误码，0 代表成功",
            "example": 0
          },
          "errMsg": {
            "type": "string",
            "description": "错误信息描述",
            "example": "success"
          }
        },
        "required": ["errCode", "errMsg"]
      },
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "head": {
            "$ref": "#/components/schemas/ResponseHeadDto"
          }
        },
        "required": ["head"]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户ID",
            "example": "testId"
          },
          "userName": {
            "type": "string",
            "description": "用户名",
            "example": "testName"
          },
          "roles": {
            "description": "角色列表",
            "example": "[\"admin\"]",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "userName", "roles"]
      },
      "PasswordLoginDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["password", "phone"],
            "description": "登录类型"
          },
          "userName": {
            "type": "string",
            "description": "用户名"
          },
          "password": {
            "type": "string",
            "description": "密码"
          }
        },
        "required": ["type", "userName", "password"]
      },
      "PhoneLoginDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["password", "phone"]
          },
          "phone": {
            "type": "string",
            "description": "手机号"
          },
          "code": {
            "type": "string",
            "description": "验证码"
          }
        },
        "required": ["type", "phone", "code"]
      },
      "CurrentLoginResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户ID",
            "example": "testId"
          },
          "userName": {
            "type": "string",
            "description": "用户名",
            "example": "testName"
          },
          "roles": {
            "description": "用户角色列表",
            "example": "[\"admin\"]",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "description": "用户权限列表",
            "example": "[\"sys:user:delete\"]",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "userName", "roles", "permissions"]
      },
      "UpdateCommonDto": {
        "type": "object",
        "properties": {}
      },
      "PaginatedResult": {
        "type": "object",
        "properties": {}
      },
      "SystemUserPageResp": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户ID",
            "example": "testId"
          },
          "userName": {
            "type": "string",
            "description": "用户名",
            "example": "testName"
          },
          "age": {
            "type": "string",
            "description": "年龄",
            "example": "1岁5月"
          }
        },
        "required": ["id", "userName", "age"]
      },
      "SystemUserResp": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户ID",
            "example": "testId"
          },
          "userName": {
            "type": "string",
            "description": "用户名",
            "example": "testName"
          },
          "age": {
            "type": "string",
            "description": "年龄",
            "example": "1岁5月"
          }
        },
        "required": ["id", "userName", "age"]
      },
      "BatchDto": {
        "type": "object",
        "properties": {}
      },
      "SystemUserCreateDto": {
        "type": "object",
        "properties": {}
      },
      "SystemUserUpdateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "状态，1：启用，0：禁用",
            "example": "1岁5月"
          }
        },
        "required": ["status"]
      },
      "BatchResp": {
        "type": "object",
        "properties": {}
      },
      "BatchUpdateStatusDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
